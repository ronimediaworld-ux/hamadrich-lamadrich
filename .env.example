# Free option (recommended) — get a key at https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Paid alternative — used only if GEMINI_API_KEY is not set
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

PORT=3001

ADMIN_PASSWORD=
# Optional: persistent storage for views/comments/submissions (free at upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional email (resend.com): notify on new submissions + weekly mail to subscribers
RESEND_API_KEY=
NOTIFY_EMAIL=
MAIL_FROM=

# Public site URL (for sitemap/canonical) and GitHub token (so dashboard content edits are committed)
SITE_URL=
GITHUB_TOKEN=
